{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-os/requirement.schema.json",
  "title": "QA OS requirement model (story-analyst output)",
  "type": "object",
  "required": ["key", "title", "app", "source", "rules", "acceptance_criteria", "screens", "ambiguities"],
  "properties": {
    "key": { "type": "string" },
    "title": { "type": "string" },
    "app": { "type": "string" },
    "region": { "type": "string" },
    "status": { "type": "string" },
    "source": { "type": "object", "required": ["kind"], "properties": {
      "kind": { "enum": ["jira-mcp", "jira-export", "pasted-text"] }, "ref": { "type": "string" }, "retrieved": { "type": "string" } } },
    "actor": { "type": "string" },
    "goal": { "type": "string" },
    "preconditions": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "acceptance_criteria": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "entities": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": {
      "name": { "type": "string" }, "maps_to": { "type": "string" }, "note": { "type": "string" } } } },
    "screens": { "type": "array", "items": { "type": "object", "required": ["story_term", "status"], "properties": {
      "story_term": { "type": "string" }, "option_id": { "type": ["string", "null"] }, "menu_path": { "type": ["string", "null"] },
      "status": { "enum": ["known-observed", "known-db-declared", "in-menu-not-learned", "not-found"] }, "note": { "type": "string" } } } },
    "scope_changes": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "out_of_scope": { "type": "array", "items": { "type": "string" } },
    "ambiguities": { "type": "array", "items": { "type": "object", "required": ["id", "question", "quote", "default"], "properties": {
      "id": { "type": "string" }, "question": { "type": "string" }, "quote": { "type": "string" },
      "default": { "type": "string", "description": "assumption used if the user does not answer" },
      "evidence": { "type": "string", "description": "what the live app / DB shows, if known" },
      "answer": { "type": ["string", "null"] } } } }
  },
  "$defs": {
    "item": { "type": "object", "required": ["id", "text"], "properties": {
      "id": { "type": "string" }, "text": { "type": "string" }, "quote": { "type": "string" }, "source": { "type": "string" } } }
  }
}
