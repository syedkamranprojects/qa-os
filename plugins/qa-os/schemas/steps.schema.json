{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-os/steps.schema.json",
  "title": "QA OS steps (step DSL v1 + v4 sentence/event columns) — a single case, or a bundle of cases (steps.json)",
  "oneOf": [
    {
      "$ref": "#/$defs/case"
    },
    {
      "$ref": "#/$defs/bundle"
    }
  ],
  "$defs": {
    "bundle": {
      "type": "object",
      "required": [
        "key",
        "app",
        "cases"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "app": {
          "type": "string"
        },
        "env": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "defaults": {
          "type": "object",
          "properties": {
            "data": {
              "type": "object"
            }
          },
          "description": "data merged under each case's data"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/case_in_bundle"
          }
        }
      }
    },
    "case": {
      "allOf": [
        {
          "$ref": "#/$defs/case_in_bundle"
        },
        {
          "required": [
            "app"
          ]
        }
      ]
    },
    "case_in_bundle": {
      "type": "object",
      "required": [
        "case",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "case": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "app": {
          "type": "string"
        },
        "env": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "readiness": {
          "enum": [
            "ready",
            "needs-data",
            "needs-knowledge",
            "needs-learning",
            "needs-verb",
            "manual",
            "deferred"
          ],
          "description": "ready = can run now; needs-data / needs-knowledge = v4 pre-run check labels (qaos_run.py check); deferred = intentionally not automated for now (e.g. file upload); otherwise see blocked_by"
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "mutates_data": {
          "type": "boolean",
          "description": "true if the case saves/updates/uploads (dev env only)"
        },
        "data": {
          "type": "object",
          "description": "The ONE data row for this case (principle 6). Referenced as {{data.x}}"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "screen": {
          "type": "string",
          "description": "v4: default screen (title or option_id of apps/<app>/screens/<option_id>.json) for steps that name none"
        },
        "path": {
          "type": "string",
          "description": "v4: path id from paths.json"
        }
      }
    },
    "step": {
      "type": "object",
      "properties": {
        "do": {
          "enum": [
            "login",
            "logout",
            "harvest_menu",
            "harvest_i18n",
            "navigate",
            "enter",
            "choose",
            "set_date",
            "click",
            "select_row",
            "verify_ui",
            "verify_db",
            "capture",
            "screenshot",
            "wait",
            "download",
            "upload",
            "edit_excel",
            "harvest_grid",
            "capture_message",
            "harvest_screen",
            "manual"
          ]
        },
        "note": {
          "type": "string"
        },
        "sentence": {
          "type": "string",
          "description": "v4: the plain-English step (no codes), executable by the QA member and the AI"
        },
        "event": {
          "enum": [
            "navigate",
            "tab",
            "load_data",
            "set",
            "choose",
            "remove_tag",
            "click",
            "grid_filter",
            "row_click",
            "verify_field",
            "verify_message",
            "wait",
            "upload",
            "download",
            "login",
            "logout"
          ],
          "description": "v4 event column: the action, filled from the screen file at design and confirmed by the AI run"
        },
        "element": {
          "type": [
            "string",
            "null"
          ],
          "description": "v4: element id from the screen file (field / button / tab / grid), or null when not bound yet"
        },
        "data_column": {
          "type": [
            "string",
            "null"
          ],
          "description": "v4: column of the case's data row that supplies the value"
        },
        "expect": {
          "description": "expected value; for event verify_message a message {type, text} (or its text); v1 verify_ui/verify_db use an object"
        },
        "screen": {
          "type": "string",
          "description": "screen of this step (title or option_id); load_data: the screen whose fields get the data row"
        },
        "tab": {
          "type": "string",
          "description": "tab of the screen (event tab / load_data)"
        },
        "mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "load_data only, optional: element id -> data column, filled by the AI run and reused for data rows and script generation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "do": {
                "const": "login"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "properties": {
              "distributor": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "navigate"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "menu"
            ],
            "properties": {
              "menu": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "enum": [
                  "enter",
                  "choose",
                  "set_date"
                ]
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "field",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "click"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "button"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "select_row"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "grid",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "verify_ui"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "expect"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "verify_db"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "recipe",
              "expect"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "capture"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "field",
              "as"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "wait"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "seconds"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "download"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "button",
              "as"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "upload"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "button",
              "file"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "edit_excel"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "file",
              "rows"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "harvest_grid"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "as"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "capture_message"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "as"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "harvest_screen"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "as"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "manual"
              }
            },
            "required": [
              "do"
            ]
          },
          "then": {
            "required": [
              "note"
            ]
          }
        },
        {
          "if": {
            "required": [
              "event"
            ],
            "properties": {
              "event": {
                "const": "load_data"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "screen"
                ]
              },
              {
                "required": [
                  "tab"
                ]
              },
              {
                "required": [
                  "sentence"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "event"
            ],
            "properties": {
              "event": {
                "const": "verify_message"
              }
            }
          },
          "then": {
            "properties": {
              "expect": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "toast",
                          "inline",
                          "popup",
                          "alert"
                        ]
                      },
                      "text": {
                        "type": "string"
                      },
                      "field": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "do"
          ]
        },
        {
          "required": [
            "sentence"
          ]
        },
        {
          "required": [
            "event"
          ]
        }
      ],
      "description": "v1 steps carry `do` (+ its slots); v4 steps carry `sentence` (plain English, the primary step for QA and AI) and the event columns event / element / data_column / expect. Both may be present."
    }
  }
}